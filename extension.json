{
	"manifest_version": 2,
	"name": "CloudflarePurge",
	"version": "1.2",
	"url": "https://www.mediawiki.org/wiki/Extension:CloudflarePurge",
	"author": "[https://www.mediawiki.org/wiki/User:Sophivorus Sophivorus]",
	"descriptionmsg": "cloudflarepurge-desc",
	"license-name": "GPL-3.0-or-later",
	"type": "user activity",
	"requires": {
		"MediaWiki": ">= 1.42"
	},
	"MessagesDirs": {
		"CloudflarePurge": [
			"i18n"
		]
	},
	"AutoloadClasses": {
		"CloudflarePurge": "CloudflarePurge.php",
		"CloudflarePurgeRelayer": "includes/CloudflarePurgeRelayer.php",
		"CloudflarePurgeRetryPolicy": "includes/CloudflarePurgeRetryPolicy.php",
		"CloudflarePurgeUrlSet": "includes/CloudflarePurgeUrlSet.php"
	},
	"TestAutoloadClasses": {
		"CloudflarePurgeCapturingRelayer": "tests/phpunit/integration/CloudflarePurgeCapturingRelayer.php"
	},
	"Hooks": {
		"PageSaveComplete": "CloudflarePurge::onPageSaveComplete",
		"PageDeleteComplete": "CloudflarePurge::onPageDeleteComplete"
	},
	"config": {
		"CloudflarePurgeZoneID": {
			"value": ""
		},
		"CloudflarePurgeToken": {
			"value": ""
		},
		"CloudflarePurgeAuthEmail": {
			"value": ""
		},
		"CloudflarePurgeAuthKey": {
			"value": ""
		},
		"CloudflarePurgeExtraHosts": {
			"value": []
		},
		"CloudflarePurgeUseCdnRelay": {
			"value": true,
			"description": "Subscribe to MediaWiki's own cdn-url-purges event channel so that pages transcluding an edited template are purged too. Disable to fall back to purging only the edited page."
		},
		"CloudflarePurgeMaxUrlsPerBatch": {
			"value": 1000
		},
		"CloudflarePurgeUrlsPerRequest": {
			"value": 100
		},
		"CloudflarePurgeMaxRetries": {
			"value": 2
		}
	},
	"callback": "CloudflarePurge::onRegistration"
}
